generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  summary     String
  body        String
  category    String
  location    String         @default("")
  projectDate DateTime
  coverImage  String         @default("")
  status      String         @default("draft")
  featured    Boolean        @default(false)
  isSample    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProjectImage[]

  @@index([status, projectDate])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String  @default("")
  sortOrder Int     @default(0)
}

model Newsletter {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  summary    String
  body       String
  issueDate  DateTime
  coverImage String   @default("")
  pdfUrl     String   @default("")
  status     String   @default("draft")
  isSample   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, issueDate])
}

model Slide {
  id             String  @id @default(cuid())
  eyebrow        String  @default("")
  title          String
  imageUrl       String  @default("")
  primaryLabel   String  @default("Donations")
  primaryHref    String  @default("/donations")
  secondaryLabel String  @default("Newsletter")
  secondaryHref  String  @default("/newsletters")
  sortOrder      Int     @default(0)
  active         Boolean @default(true)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
